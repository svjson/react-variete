{
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "esModuleInterop": true,

    "target": "ES2022",
    "module": "ESNext",

    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
