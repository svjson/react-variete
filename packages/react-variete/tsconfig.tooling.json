{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": true,

    "lib": ["ES2022", "DOM"],

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,

    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"],

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tooling.tsbuildinfo"
  },
  "include": [
    "src",
    "test",
    "types-test"
  ]
}
